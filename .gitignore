# Más información sobre cómo ignorar ficheros: https://help.github.com/articles/ignoring-files/

# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# producción
/build

# varios
.DS_Store
*.pem

# depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ficheros de entorno (se puede optar por versionarlos si hace falta)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefactos de los tests
/test-results/
/playwright-report/
/blob-report/

# contenido privado del seed (datos reales): nunca se versiona ni va en las imágenes
db/seed/*.local.json
