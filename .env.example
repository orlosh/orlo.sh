# ---------------------------------------------------------------------------
# Entorno LOCAL. Copia este fichero a .env y rellénalo. Nunca subas .env.
# Genera secretos con:  openssl rand -base64 32
#
# Producción NO usa este fichero: sus variables se configuran en Vercel
# (Settings → Environment Variables) y en los secretos de GitHub.
# Ver docs/deployment.md.
# ---------------------------------------------------------------------------

# --- Contenedor de PostgreSQL local (solo para arrancarlo) --------------------
# Superusuario; lo usa únicamente la imagen de postgres en el primer arranque.
POSTGRES_PASSWORD=change-me-superuser
# Propietario del esquema: ejecuta las migraciones (DDL). La app nunca lo usa.
DB_OWNER_PASSWORD=change-me-owner
# Rol de la aplicación: solo SELECT/INSERT/UPDATE/DELETE.
DB_APP_PASSWORD=change-me-app
DB_NAME=portfolio

# --- Cadenas de conexión -------------------------------------------------------
# Desde el host (pnpm dev). Dentro de Compose la app usa el host "db".
DATABASE_URL=postgres://portfolio_app:change-me-app@localhost:5432/portfolio
MIGRATION_DATABASE_URL=postgres://portfolio_owner:change-me-owner@localhost:5432/portfolio
# Conexiones máximas por instancia (en Vercel, bajo: 3-5).
DATABASE_POOL_MAX=5
# Sentencias preparadas. Poner "false" solo si el pooler de Neon diera errores con ellas.
DATABASE_PREPARE=true

# --- Aplicación ----------------------------------------------------------------
# Origen público (URLs canónicas, sitemap, comprobación de origen de la auth).
APP_URL=http://localhost:3000
# Mínimo 32 caracteres aleatorios. Firma las cookies de sesión.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-min
LOG_LEVEL=info
# Cabecera de confianza con la IP del cliente. Vacía en local.
# En Vercel: x-real-ip. Detrás de Caddy (self-hosting): x-forwarded-for.
TRUSTED_IP_HEADER=

# --- Tests -----------------------------------------------------------------------
# Los tests de integración usan <DB_NAME>_test (la crea docker/postgres/10-roles.sh).
TEST_DATABASE_URL=postgres://portfolio_app:change-me-app@localhost:5432/portfolio_test
TEST_MIGRATION_DATABASE_URL=postgres://portfolio_owner:change-me-owner@localhost:5432/portfolio_test
